# Job Scraper Email Configuration

# Email Provider: gmail, smtp, or sendgrid
EMAIL_PROVIDER=gmail

# Recipient Email Address (where job alerts will be sent)
EMAIL_TO=your-email@example.com

# Gmail Configuration (if using Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Custom SMTP Configuration (if using custom SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# SendGrid Configuration (if using SendGrid)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Cron Schedule for Daily Job Scraping
# Default: "0 9 * * *" (every day at 9:00 AM)
# Format: minute hour day month dayOfWeek
# Examples:
#   "0 9 * * *"    - Every day at 9:00 AM
#   "0 */6 * * *"  - Every 6 hours
#   "0 9 * * 1-5"  - Every weekday at 9:00 AM
CRON_SCHEDULE=0 9 * * *

# Enable/Disable Scheduler (true/false)
SCHEDULER_ENABLED=true
